{
    http_port {$HTTP_PORT}
    https_port {$HTTPS_PORT}
}

{$BASE_URL} {
    handle {$API_CONTEXT}/actuator* {
        reverse_proxy localhost:{$VITE_PORT}
    }
    handle {$API_CONTEXT}* {
        reverse_proxy localhost:{$API_PORT}
    }
    handle {$OAUTH_CONTEXT}* {
        reverse_proxy localhost:{$OAUTH_PORT}
    }
    handle {
        reverse_proxy localhost:{$VITE_PORT}
    }
}
