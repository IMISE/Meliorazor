BASE_URL=localhost
HTTP_PORT=80
HTTPS_PORT=443

# read by reverse proxy
VITE_PORT=8079
OAUTH_PORT=8080
API_PORT=8081

API_CONTEXT=/api
OAUTH_CONTEXT=/auth

# in case someone wants to run the DB locally
DB_HOST=annotator-database
DB_PORT=8082

DB_USER=annotator
DB_PASSWORD=CHANGEME
DB_NAME=annotator

VITE_OAUTH_REALM=annotator
VITE_OAUTH_CLIENT_ID=annotator_oid_client
VITE_OAUTH_BASE=https://${BASE_URL}:${HTTPS_PORT}${OAUTH_CONTEXT}
VITE_API_BASE=https://${BASE_URL}:${HTTPS_PORT}${API_CONTEXT}

OAUTH_ADMIN_USER=annotator_admin
OAUTH_ADMIN_PASSWORD=CHANGEME
